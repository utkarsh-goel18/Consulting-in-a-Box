# ==============================================================================
# Consulting in a Box - Environment Configuration Template
# ==============================================================================

# Application Mode
DEMO_MODE=true
PROJECT_NAME="Consulting in a Box"

# Analytics Database (Optional: Leave empty to run with zero-config DuckDB embedded engine)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/consulting_box

# AI Intelligence Provider: 'mock' (default, offline & deterministic), 'gemini', or 'openai'
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash

# API Keys (Optional - only required if AI_PROVIDER is set to gemini or openai)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
