# ==============================================================================
# Consulting in a Box - Backend Configuration
# ==============================================================================

DEMO_MODE=true
PROJECT_NAME="Consulting in a Box"

# PostgreSQL connection (Optional: embedded DuckDB runs by default if not available)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/consulting_box

# AI Provider: 'mock' (offline), 'gemini', or 'openai'
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash

# API Keys (optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
